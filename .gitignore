# ==========================================
# MACHINE LEARNING (BACKEND) IGNORES
# ==========================================
# Python Virtual Environment
.venv/
env/
venv/
__pycache__/
*.pyc

# Data folders (CRITICAL to ignore, too large for Git)
data/
*.parquet
*.csv

# Jupyter Checkpoints
.ipynb_checkpoints/

# Old Models and Notebooks
test_models/
notebooks/
summaries/

# ==========================================
# FRONTEND IGNORES
# ==========================================
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

tuning_artifacts/
